@using Travel_Trip_Project.Models.Siniflar
@model List<Blog>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Blog Listesi</h2>
<br />
<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Başlık</th>
            <th>Sil</th>
            <th>Güncelle</th>
            <th>Detaylar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.ID</td>
                <td>@x.Baslik</td>
                <td><a href="/Admin/BlogSil/@x.ID" class="btn btn-danger btn-m">Sil</a></td>
                <td><a href="/Admin/BlogGetir/@x.ID" class="btn btn-warning btn-m">Güncelle</a></td>
                <td><a href="#" class="btn btn-outline-dark btn-m">Detaylar</a></td>
            </tr>
        }

    </tbody>
</table>
<a href="/Admin/YeniBlog/" class="btn btn-primary">Yeni Blog </a>
