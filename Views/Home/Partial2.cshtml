@using Travel_Trip_Project.Models.Siniflar
@model List<Blog>

<div class="padding1">
    <h4>En Begendigim Yerler</h4>
    
    <div class="box-left">
        @foreach (var x in Model)
        {
            <div class="bot-img">
                <img src="@x.BlogImage" alt=""  style="height:85px;width:120px"/>
            </div>
            <div class="bot-desc">
                <p>@x.Aciklama.Substring(0,75)... </p>
            </div>
            <div class="clear"></div>
            
            
        }
    </div>
    @Html.Action("Partial3","Home")
</div>