<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Yönetim Paneli</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Optional: Bootstrap Icons (useful for admin panels) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* Sidebar styling to keep it fixed on the left */
        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }
        /* Offset main content so it doesn't overlap with sidebar */
        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }
    </style>
</head>
<body class="bg-light">

    <!-- Sidebar -->
    @{
        // Mevcut Controller ve Action isimlerini alıyoruz
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="sidebar bg-dark text-white p-3">
        <h4 class="text-center py-2 border-bottom border-secondary mb-3">Menüler</h4>
        <div class="nav nav-pills flex-column mb-auto">

            <a href="/Admin/Index/" class="nav-link text-white my-1 @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-journal-text me-2"></i> Bloglar
            </a>

            <a href="/Admin/YorumListesi/" class="nav-link text-white my-1 @(currentController == "Admin" && currentAction == "YorumListesi" ? "active" : "")">
                <i class="bi bi-chat-left-text me-2"></i> Yorumlar
            </a>

            <a href="/Admin/Iletisim/" class="nav-link text-white my-1 @(currentController == "Admin" && currentAction == "Iletisim" ? "active" : "")">
                <i class="bi bi-envelope me-2"></i> İletişim
            </a>

            <a href="/Admin/Hakkimizda/" class="nav-link text-white my-1 @(currentController == "Admin" && currentAction == "Hakkimizda" ? "active" : "")">
                <i class="bi bi-info-circle me-2"></i> Hakkımızda
            </a>

            <a href="/Home/Index" class="nav-link text-white my-1 @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-globe me-2"></i> Siteye Git
            </a>
            <a href="/GirisYap/LogOut" class="nav-link text-white my-1">
                <i class="bi bi-door-open me-2"></i> Cikis Yap
            </a>

        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content d-flex flex-column">

        <!-- Top Header Bar -->
        <header class="bg-primary text-white p-3 shadow-sm">
            <div class="container-fluid">
                <h2 class="h4 mb-0">Admin Yönetim Paneli</h2>
            </div>
        </header>

        <!-- Body Content -->
        <main class="container-fluid p-4 flex-grow-1">
            @RenderBody()
        </main>

    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>